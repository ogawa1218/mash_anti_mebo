# --- MCP ---
MCP_SERVICE_TOKEN=change-me                    # Bearer token for HTTP transport
MCP_MAX_EXP_PER_CALL=500                       # LLM暴走時のサーバー側クランプ

# --- Game tuning ---
EXP_ALPHA=10.0
