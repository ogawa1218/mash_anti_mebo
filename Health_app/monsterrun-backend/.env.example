# --- Core ---
DATABASE_URL=postgresql+asyncpg://monsterrun:monsterrun@localhost:5432/monsterrun
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-openssl-rand-hex-32
TOKEN_ENCRYPTION_KEY=   # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Garmin Connect Developer Program ---
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# --- Strava ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
