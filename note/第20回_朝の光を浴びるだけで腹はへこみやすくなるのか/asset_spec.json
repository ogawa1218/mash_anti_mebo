      "bodyHtml": "<div class='panel' style='position:absolute;left:86px;top:180px;width:250px;height:220px;padding:24px;border-color:#ff6d0055;'><div class='orange' style='font-size:22px;font-weight:900;'>朝の光</div><div style='font-size:32px;font-weight:900;line-height:1.35;margin-top:16px;'>起床後に<br>屋外光を入れる</div></div><div style='position:absolute;left:372px;top:258px;font-size:54px;font-weight:900;color:#38bdf8;'>→</div><div class='panel' style='position:absolute;left:470px;top:180px;width:250px;height:220px;padding:24px;border-color:#38bdf855;'><div class='blue' style='font-size:22px;font-weight:900;'>体内時計</div><div style='font-size:32px;font-weight:900;line-height:1.35;margin-top:16px;'>主時計が<br>前に進みやすい</div></div><div style='position:absolute;left:756px;top:258px;font-size:54px;font-weight:900;color:#4ade80;'>→</div><div class='panel' style='position:absolute;right:86px;top:180px;width:250px;height:220px;padding:24px;border-color:#4ade8055;'><div class='green' style='font-size:22px;font-weight:900;'>夜の崩れ防止</div><div style='font-size:32px;font-weight:900;line-height:1.35;margin-top:16px;'>眠気が来やすい<br>夜食が減りやすい</div></div><div style='position:absolute;left:120px;right:120px;bottom:78px;text-align:center;font-size:24px;font-weight:800;'>朝の光は<span class='orange'>痩せる魔法</span>ではなく、<span class='green'>夜の崩れを減らす準備</span>。</div>"
