  "figures": [
    {
      "name": "figure_01_時間より固定",
      "title": "朝運動は「何時」より「固定できるか」が重要",
      "bodyHtml": "<div style='position:absolute;left:100px;top:190px;display:flex;gap:24px;align-items:center;'><div class='panel' style='width:300px;height:240px;padding:24px;border-color:#ff6d0055;'><div class='orange' style='font-size:22px;font-weight:900;'>よくある誤解</div><div style='font-size:34px;font-weight:900;line-height:1.45;margin-top:18px;'>7時台\nじゃないと\n意味がない</div></div><div style='font-size:56px;font-weight:900;color:#38bdf8;'>→</div><div class='panel' style='width:320px;height:240px;padding:24px;border-color:#38bdf855;'><div class='blue' style='font-size:22px;font-weight:900;'>現実解</div><div style='font-size:34px;font-weight:900;line-height:1.45;margin-top:18px;'>出勤前でも\n通勤中でも\n朝に固定する</div></div><div style='font-size:56px;font-weight:900;color:#4ade80;'>→</div><div class='panel' style='width:250px;height:240px;padding:24px;border-color:#4ade8055;'><div class='green' style='font-size:22px;font-weight:900;'>勝ち筋</div><div style='font-size:34px;font-weight:900;line-height:1.45;margin-top:18px;'>ゼロを\n減らす</div></div></div>"
    },
    {
      "name": "figure_02_朝運動の連鎖",
      "title": "朝に動くと、その日の後半が崩れにくくなる",
      "bodyHtml": "<div style='position:absolute;left:95px;top:205px;display:flex;gap:20px;align-items:center;'><div class='panel' style='width:220px;height:170px;padding:20px;border-color:#ff6d0055;'><div class='orange' style='font-size:20px;font-weight:900;'>朝に動く</div><div style='font-size:26px;font-weight:900;line-height:1.5;margin-top:16px;'>実行率が高い\n先に前進</div></div><div style='font-size:46px;font-weight:900;color:#38bdf8;'>→</div><div class='panel' style='width:220px;height:170px;padding:20px;border-color:#38bdf855;'><div class='blue' style='font-size:20px;font-weight:900;'>気分が整う</div><div style='font-size:26px;font-weight:900;line-height:1.5;margin-top:16px;'>自己効力感\n上昇</div></div><div style='font-size:46px;font-weight:900;color:#4ade80;'>→</div><div class='panel' style='width:220px;height:170px;padding:20px;border-color:#4ade8055;'><div class='green' style='font-size:20px;font-weight:900;'>食事が整う</div><div style='font-size:26px;font-weight:900;line-height:1.5;margin-top:16px;'>夜の崩れ\n減少</div></div><div style='font-size:46px;font-weight:900;color:#facc15;'>→</div><div class='panel' style='width:220px;height:170px;padding:20px;border-color:#facc1555;'><div class='yellow' style='font-size:20px;font-weight:900;color:#facc15;'>続きやすい</div><div style='font-size:26px;font-weight:900;line-height:1.5;margin-top:16px;'>翌日も\n戻れる</div></div></div>"
    },
    {
      "name": "figure_03_通勤内朝運動",
      "title": "出勤前〜通勤中まで含めれば、朝運動はかなり現実的になる",
      "bodyHtml": "<div style='position:absolute;left:110px;top:190px;display:flex;gap:22px;'><div class='panel' style='width:290px;height:250px;padding:24px;border-color:#ff6d0055;'><div class='orange' style='font-size:22px;font-weight:900;'>家の前</div><div style='font-size:30px;font-weight:900;line-height:1.45;margin-top:18px;'>外に出る\n3分歩く\n光を浴びる</div></div><div class='panel' style='width:290px;height:250px;padding:24px;border-color:#38bdf855;'><div class='blue' style='font-size:22px;font-weight:900;'>通勤導線</div><div style='font-size:30px;font-weight:900;line-height:1.45;margin-top:18px;'>1駅歩く\n遠回り\n早歩き区間</div></div><div class='panel' style='width:290px;height:250px;padding:24px;border-color:#4ade8055;'><div class='green' style='font-size:22px;font-weight:900;'>駅・オフィス</div><div style='font-size:30px;font-weight:900;line-height:1.45;margin-top:18px;'>階段を使う\nエスカレーター回避\nゼロ防止</div></div></div>"
    },
    {
      "name": "figure_04_ifthen設計",
      "title": "朝運動は代替案込みの if-then があると切れにくい",
      "bodyHtml": "<div style='position:absolute;left:95px;top:205px;display:flex;gap:20px;align-items:center;'><div class='panel' style='width:220px;height:170px;padding:20px;border-color:#ff6d0055;'><div class='orange' style='font-size:20px;font-weight:900;'>起床したら</div><div style='font-size:26px;font-weight:900;line-height:1.5;margin-top:16px;'>水を飲む\nカーテンを開ける</div></div><div style='font-size:46px;font-weight:900;color:#38bdf8;'>→</div><div class='panel' style='width:220px;height:170px;padding:20px;border-color:#38bdf855;'><div class='blue' style='font-size:20px;font-weight:900;'>外に出たら</div><div style='font-size:26px;font-weight:900;line-height:1.5;margin-top:16px;'>10分歩く\nまたは3分</div></div><div style='font-size:46px;font-weight:900;color:#4ade80;'>→</div><div class='panel' style='width:220px;height:170px;padding:20px;border-color:#4ade8055;'><div class='green' style='font-size:20px;font-weight:900;'>雨・寝坊</div><div style='font-size:26px;font-weight:900;line-height:1.5;margin-top:16px;'>室内足踏み\n通勤階段</div></div><div style='font-size:46px;font-weight:900;color:#facc15;'>→</div><div class='panel' style='width:220px;height:170px;padding:20px;border-color:#facc1555;'><div class='yellow' style='font-size:20px;font-weight:900;color:#facc15;'>連鎖維持</div><div style='font-size:26px;font-weight:900;line-height:1.5;margin-top:16px;'>ゼロを\n防ぐ</div></div></div>"
    },
