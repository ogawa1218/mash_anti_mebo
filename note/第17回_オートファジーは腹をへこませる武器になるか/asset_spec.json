  "figures": [
    {
      "name": "figure_01_オートファジーを腹の話に翻訳",
      "title": "オートファジーを腹の話に翻訳するとこうなる",
      "bodyHtml": "<div class='panel' style='position:absolute;left:78px;top:160px;width:300px;height:250px;padding:24px;border-color:#ff6d0055;'><div class='orange' style='font-size:24px;font-weight:900;margin-bottom:12px;'>入力過多</div><div style='font-size:28px;font-weight:900;line-height:1.45;'>夜遅い食事<br>寝不足<br>だらだら間食</div></div><div style='position:absolute;left:422px;top:248px;font-size:54px;font-weight:900;color:#38bdf8;'>→</div><div class='panel' style='position:absolute;left:500px;top:160px;width:300px;height:250px;padding:24px;border-color:#38bdf855;'><div class='blue' style='font-size:24px;font-weight:900;margin-bottom:12px;'>処理優先</div><div style='font-size:28px;font-weight:900;line-height:1.45;'>ずっと食べる<br>空腹感が乱れる<br>夜食へ流れる</div></div><div style='position:absolute;left:844px;top:248px;font-size:54px;font-weight:900;color:#4ade80;'>→</div><div class='panel' style='position:absolute;right:78px;top:160px;width:300px;height:250px;padding:24px;border-color:#4ade8055;'><div class='green' style='font-size:24px;font-weight:900;margin-bottom:12px;'>現実解</div><div style='font-size:28px;font-weight:900;line-height:1.45;'>食事間隔を取る<br>夜食を減らす<br>睡眠を守る</div></div><div style='position:absolute;left:120px;right:120px;bottom:72px;text-align:center;font-size:24px;font-weight:800;'>神秘化するな。<span class='orange'>掃除の時間</span>を生活の中に確保する。</div>"
    },
    {
      "name": "figure_02_12h14h16hの考え方",
      "title": "12時間・14時間・16時間の現実的な考え方",
      "bodyHtml": "<div class='panel' style='position:absolute;left:82px;top:158px;width:320px;height:300px;padding:24px;border-color:#38bdf855;'><div class='blue' style='font-size:24px;font-weight:900;margin-bottom:14px;'>12時間</div><div style='font-size:34px;font-weight:900;line-height:1.35;'>まず整える</div><div class='muted' style='font-size:20px;line-height:1.7;margin-top:18px;'>夜食を止める<br>生活リズムを戻す<br>ほぼ全員が始めやすい</div></div><div class='panel' style='position:absolute;left:480px;top:138px;width:320px;height:340px;padding:24px;border-color:#4ade8055;box-shadow:0 0 36px #4ade8022;'><div class='green' style='font-size:24px;font-weight:900;margin-bottom:14px;'>14時間</div><div style='font-size:34px;font-weight:900;line-height:1.35;'>変わる人が増える</div><div class='muted' style='font-size:20px;line-height:1.7;margin-top:18px;'>間食が減る<br>空腹感が整う<br>実務ではかなり強い</div></div><div class='panel' style='position:absolute;right:82px;top:158px;width:320px;height:300px;padding:24px;border-color:#ff6d0055;'><div class='orange' style='font-size:24px;font-weight:900;margin-bottom:14px;'>16時間</div><div style='font-size:34px;font-weight:900;line-height:1.35;'>合う人には武器</div><div class='muted' style='font-size:20px;line-height:1.7;margin-top:18px;'>魔法ではない<br>無理なら押さない<br>続く人だけ採用</div></div><div style='position:absolute;left:120px;right:120px;bottom:70px;text-align:center;font-size:24px;font-weight:800;'>16時間が偉いのではない。<span class='green'>続く時間</span>が正解。</div>"
    },
    {
      "name": "figure_03_合う人合わない人",
      "title": "朝食を遅らせる型が合う人・合わない人",
      "bodyHtml": "<div class='panel' style='position:absolute;left:70px;top:150px;width:520px;height:360px;'><div style='padding:28px;'><div class='green' style='font-size:28px;font-weight:900;margin-bottom:16px;'>合いやすい人</div><div style='font-size:24px;line-height:1.8;font-weight:700;'>・朝は空腹が弱い<br>・朝食で眠くなりやすい<br>・午前中に集中したい<br>・昼前の菓子パン習慣を切りたい</div></div></div><div class='panel' style='position:absolute;right:70px;top:150px;width:520px;height:360px;'><div style='padding:28px;'><div class='orange' style='font-size:28px;font-weight:900;margin-bottom:16px;'>合いにくい人</div><div style='font-size:24px;line-height:1.8;font-weight:700;'>・空腹でふらつく<br>・朝から立ち仕事が重い<br>・朝のパフォーマンスが落ちる<br>・治療中で医学的に注意が必要</div></div></div><div style='position:absolute;left:110px;right:110px;bottom:72px;text-align:center;font-size:22px;font-weight:800;'>時間を真似するな。<span class='blue'>生活にハマるか</span>で決める。</div>"
    },
    {
      "name": "figure_04_夜の設計",
      "title": "腹を変える人が先に整えるのは夜",
      "bodyHtml": "<div class='panel' style='position:absolute;left:88px;top:168px;width:300px;height:250px;padding:24px;border-color:#ff6d0055;'><div class='orange' style='font-size:22px;font-weight:900;margin-bottom:10px;'>失敗</div><div style='font-size:30px;font-weight:900;line-height:1.35;'>夜をゼロ固定<br>→ 22時に崩れる</div></div><div style='position:absolute;left:430px;top:250px;font-size:54px;font-weight:900;color:#38bdf8;'>→</div><div class='panel' style='position:absolute;left:510px;top:148px;width:300px;height:290px;padding:24px;border-color:#38bdf855;'><div class='blue' style='font-size:22px;font-weight:900;margin-bottom:10px;'>現実解</div><div style='font-size:30px;font-weight:900;line-height:1.35;'>夕食で<br>主食を適量<br>夜食に流れない</div></div><div style='position:absolute;left:852px;top:250px;font-size:54px;font-weight:900;color:#4ade80;'>→</div><div class='panel' style='position:absolute;right:88px;top:168px;width:300px;height:250px;padding:24px;border-color:#4ade8055;'><div class='green' style='font-size:22px;font-weight:900;margin-bottom:10px;'>結果</div><div style='font-size:30px;font-weight:900;line-height:1.35;'>睡眠が崩れにくい<br>翌日の食欲も安定</div></div><div style='position:absolute;left:120px;right:120px;bottom:70px;text-align:center;font-size:24px;font-weight:800;'>夜の目的は<span class='orange'>ゼロ化</span>ではなく、<span class='green'>夜食を防ぐこと</span>。</div>"
    },
    {
      "name": "figure_05_飲み会の勝ちパターン",
      "title": "飲み会で崩れても、翌日に戻れる人が勝つ",
      "bodyHtml": "<div class='panel' style='position:absolute;left:84px;top:164px;width:330px;height:250px;padding:24px;border-color:#ff6d0055;'><div class='orange' style='font-size:22px;font-weight:900;margin-bottom:12px;'>STEP 1</div><div style='font-size:32px;font-weight:900;line-height:1.35;'>酒は<br>最初の1杯だけ</div></div><div class='panel' style='position:absolute;left:475px;top:164px;width:330px;height:250px;padding:24px;border-color:#38bdf855;'><div class='blue' style='font-size:22px;font-weight:900;margin-bottom:12px;'>STEP 2</div><div style='font-size:32px;font-weight:900;line-height:1.35;'>デザートは<br>触らない</div></div><div class='panel' style='position:absolute;right:84px;top:164px;width:330px;height:250px;padding:24px;border-color:#4ade8055;'><div class='green' style='font-size:22px;font-weight:900;margin-bottom:12px;'>STEP 3</div><div style='font-size:32px;font-weight:900;line-height:1.35;'>帰りは<br>歩いて帰る</div></div><div style='position:absolute;left:110px;right:110px;bottom:74px;text-align:center;font-size:24px;font-weight:800;'>完璧主義ではなく、<span class='blue'>翌日に戻れる設計</span>が勝ち筋。</div>"
    }
