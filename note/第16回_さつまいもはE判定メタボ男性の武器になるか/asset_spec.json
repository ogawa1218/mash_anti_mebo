  "figures": [
    {
      "name": "figure_01_さつまいもが効く場所",
      "title": "さつまいもが効くのは、朝よりその後",
      "bodyHtml": "<div style='position:absolute;left:90px;top:150px;display:flex;flex-direction:column;gap:20px;'><div class='panel' style='width:980px;padding:18px 24px;font-size:28px;font-weight:800;border-color:#ff6d0055;'>朝：白パン・菓子パンを さつまいも1本へ置換</div><div class='panel' style='width:980px;padding:18px 24px;font-size:28px;font-weight:800;border-color:#38bdf855;'>10時：空腹の暴走が小さくなりやすい</div><div class='panel' style='width:980px;padding:18px 24px;font-size:28px;font-weight:800;border-color:#4ade8055;'>昼：ドカ食いを少し抑えやすい</div><div class='panel' style='width:980px;padding:18px 24px;font-size:28px;font-weight:800;border-color:#38bdf855;'>15時：眠気・間食欲を観察する</div></div><div class='panel' style='position:absolute;right:84px;bottom:72px;width:360px;padding:18px 20px;font-size:18px;line-height:1.7;color:#d1d5db;'>狙うのは食材の魔法ではなく、朝から夕方までの崩れを1段階小さくすること。</div>"
    },
    {
      "name": "figure_02_言えること言えないこと",
      "title": "さつまいもで、何が言えて何が言えないか",
      "bodyHtml": "<div class='panel' style='position:absolute;left:70px;top:150px;width:520px;height:360px;'><div style='padding:26px;'><div class='orange' style='font-size:28px;font-weight:900;margin-bottom:16px;'>言えること</div><div style='font-size:24px;line-height:1.8;font-weight:700;'>・白パンより崩れにくい朝を作りやすい<br>・満足感のある置換にしやすい<br>・量を固定しやすい</div></div></div><div class='panel' style='position:absolute;right:70px;top:150px;width:520px;height:360px;'><div style='padding:26px;'><div class='blue' style='font-size:28px;font-weight:900;margin-bottom:16px;'>言えないこと</div><div style='font-size:24px;line-height:1.8;font-weight:700;'>・さつまいもは常に低GI<br>・食べるだけで脂肪が落ちる<br>・量を増やしてもOK</div></div></div><div style='position:absolute;left:130px;right:130px;bottom:74px;text-align:center;font-size:24px;font-weight:800;'>勝負は <span class='orange'>食材</span> ではなく <span class='blue'>置き換え設計</span> で決まる。</div>"
    },
    {
      "name": "figure_03_朝の勝ちパターン",
      "title": "最初の勝ちパターンはこれだけ",
      "bodyHtml": "<div class='panel' style='position:absolute;left:94px;top:170px;width:300px;height:250px;border-color:#ff6d0055;'><div style='padding:24px;'><div class='orange' style='font-size:22px;font-weight:900;margin-bottom:10px;'>STEP 1</div><div style='font-size:30px;font-weight:900;line-height:1.3;'>主食を<br>さつまいも1本へ</div></div></div><div class='panel' style='position:absolute;left:490px;top:170px;width:300px;height:250px;border-color:#38bdf855;'><div style='padding:24px;'><div class='blue' style='font-size:22px;font-weight:900;margin-bottom:10px;'>STEP 2</div><div style='font-size:30px;font-weight:900;line-height:1.3;'>卵1〜2個か<br>ヨーグルト追加</div></div></div><div class='panel' style='position:absolute;right:94px;top:170px;width:300px;height:250px;border-color:#4ade8055;'><div style='padding:24px;'><div class='green' style='font-size:22px;font-weight:900;margin-bottom:10px;'>STEP 3</div><div style='font-size:30px;font-weight:900;line-height:1.3;'>15時の自分を<br>観察する</div></div></div><div style='position:absolute;left:140px;right:140px;bottom:80px;text-align:center;font-size:24px;font-weight:800;'>足すな。<span class='orange'>置き換える</span>。それだけで十分スタートできる。</div>"
    },
    {
      "name": "figure_04_1週間プロトコル",
      "title": "さつまいも置換 1週間プロトコル",
      "bodyHtml": "<div class='panel' style='position:absolute;left:82px;top:150px;width:500px;height:138px;border-color:#ff6d0055;'><div style='padding:22px 24px;display:flex;gap:16px;'><div style='width:56px;height:56px;border-radius:50%;background:#ff6d00;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:900;color:#000;'>1</div><div><div style='font-size:28px;font-weight:900;'>Day1-3 朝主食を置換</div><div class='muted' style='font-size:18px;margin-top:6px;'>食後眠気・昼前空腹を記録</div></div></div></div><div class='panel' style='position:absolute;right:82px;top:150px;width:500px;height:138px;border-color:#38bdf855;'><div style='padding:22px 24px;display:flex;gap:16px;'><div style='width:56px;height:56px;border-radius:50%;background:#38bdf8;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:900;color:#000;'>2</div><div><div style='font-size:28px;font-weight:900;'>Day4-5 15時を観察</div><div class='muted' style='font-size:18px;margin-top:6px;'>間食欲・集中力を見る</div></div></div></div><div class='panel' style='position:absolute;left:82px;top:334px;width:500px;height:138px;border-color:#ff6d0055;'><div style='padding:22px 24px;display:flex;gap:16px;'><div style='width:56px;height:56px;border-radius:50%;background:#ff6d00;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:900;color:#000;'>3</div><div><div style='font-size:28px;font-weight:900;'>Day6-7 夕方評価</div><div class='muted' style='font-size:18px;margin-top:6px;'>だるさ・継続しやすさで判定</div></div></div></div><div class='panel' style='position:absolute;right:82px;top:334px;width:500px;height:138px;border-color:#38bdf855;'><div style='padding:22px 24px;display:flex;gap:16px;'><div style='width:56px;height:56px;border-radius:50%;background:#38bdf8;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:900;color:#000;'>4</div><div><div style='font-size:28px;font-weight:900;'>体重より先に体感</div><div class='muted' style='font-size:18px;margin-top:6px;'>10時・15時・夕方の自分を見る</div></div></div></div>"
    },
    {
      "name": "figure_05_向いている人注意が必要な人",
      "title": "さつまいも置換は誰に向くか",
      "bodyHtml": "<div class='panel' style='position:absolute;left:76px;top:152px;width:500px;height:360px;'><div style='padding:28px;'><div class='green' style='font-size:28px;font-weight:900;margin-bottom:16px;'>向いている人</div><div style='font-size:24px;line-height:1.8;font-weight:700;'>・朝がパンだけになりやすい<br>・10時や15時に崩れやすい<br>・主食を固定したい<br>・コンビニでも再現したい</div></div></div><div class='panel' style='position:absolute;right:76px;top:152px;width:500px;height:360px;'><div style='padding:28px;'><div class='orange' style='font-size:28px;font-weight:900;margin-bottom:16px;'>注意が必要な人</div><div style='font-size:24px;line-height:1.8;font-weight:700;'>・糖尿病治療中<br>・血糖降下薬を使用中<br>・カリウム制限がある<br>・干しいもで量が増えやすい</div></div></div><div style='position:absolute;left:120px;right:120px;bottom:70px;text-align:center;font-size:22px;font-weight:800;'>迷ったら <span class='blue'>焼きいも1本＋卵</span> から。自己流で押し切らない。</div>"
    }
