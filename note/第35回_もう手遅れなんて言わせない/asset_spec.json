      "bodyHtml": "<div style='position:absolute;left:100px;top:195px;display:flex;gap:22px;'><div class='panel' style='width:320px;height:250px;padding:24px;border-color:#ff6d0055;'><div class='orange' style='font-size:22px;font-weight:900;'>運動</div><div style='font-size:30px;font-weight:900;line-height:1.45;margin-top:18px;'>30分速歩\n筋トレ\n食後10分歩行</div></div><div class='panel' style='width:320px;height:250px;padding:24px;border-color:#38bdf855;'><div class='blue' style='font-size:22px;font-weight:900;'>栄養</div><div style='font-size:30px;font-weight:900;line-height:1.45;margin-top:18px;'>腹八分目\n夜遅い食事を減らす\n野菜・豆・魚</div></div><div class='panel' style='width:320px;height:250px;padding:24px;border-color:#4ade8055;'><div class='green' style='font-size:22px;font-weight:900;'>回復</div><div style='font-size:30px;font-weight:900;line-height:1.45;margin-top:18px;'>起床時刻固定\n刺激を減らす\n入浴</div></div></div>"
