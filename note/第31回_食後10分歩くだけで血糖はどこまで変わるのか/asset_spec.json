      "bodyHtml": "<div style='position:absolute;left:105px;top:195px;display:flex;align-items:center;gap:22px;'><div class='panel' style='width:250px;height:170px;padding:22px;border-color:#ff6d0055;'><div class='orange' style='font-size:22px;font-weight:900;'>食後に歩く</div><div style='font-size:28px;font-weight:900;line-height:1.4;margin-top:18px;'>筋肉が糖を\n使いやすい</div></div><div style='font-size:52px;font-weight:900;color:#ff6d00;'>→</div><div class='panel' style='width:250px;height:170px;padding:22px;border-color:#38bdf855;'><div class='blue' style='font-size:22px;font-weight:900;'>血糖の波</div><div style='font-size:28px;font-weight:900;line-height:1.4;margin-top:18px;'>急上昇を\n抑えやすい</div></div><div style='font-size:52px;font-weight:900;color:#38bdf8;'>→</div><div class='panel' style='width:250px;height:170px;padding:22px;border-color:#4ade8055;'><div class='green' style='font-size:22px;font-weight:900;'>午後の体感</div><div style='font-size:28px;font-weight:900;line-height:1.4;margin-top:18px;'>眠気・だるさ・\n間食を減らしやすい</div></div></div>"
