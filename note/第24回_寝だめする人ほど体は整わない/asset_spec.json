      "bodyHtml": "<div style='position:absolute;left:72px;top:180px;display:flex;gap:18px;align-items:center;'><div class='panel' style='width:210px;height:210px;padding:22px;border-color:#ff6d0055;'><div class='orange' style='font-size:22px;font-weight:900;'>平日</div><div style='font-size:30px;font-weight:900;line-height:1.35;margin-top:18px;'>早起きで無理する</div></div><div style='font-size:44px;font-weight:900;color:#ff6d00;'>→</div><div class='panel' style='width:210px;height:210px;padding:22px;border-color:#38bdf855;'><div class='blue' style='font-size:22px;font-weight:900;'>休日</div><div style='font-size:30px;font-weight:900;line-height:1.35;margin-top:18px;'>遅くまで寝る</div></div><div style='font-size:44px;font-weight:900;color:#38bdf8;'>→</div><div class='panel' style='width:210px;height:210px;padding:22px;border-color:#4ade8055;'><div class='green' style='font-size:22px;font-weight:900;'>日曜夜</div><div style='font-size:30px;font-weight:900;line-height:1.35;margin-top:18px;'>寝つきにくい</div></div><div style='font-size:44px;font-weight:900;color:#4ade80;'>→</div><div class='panel' style='width:210px;height:210px;padding:22px;border-color:#ff6d0055;'><div class='orange' style='font-size:22px;font-weight:900;'>月曜</div><div style='font-size:30px;font-weight:900;line-height:1.35;margin-top:18px;'>朝が地獄</div></div></div>"
